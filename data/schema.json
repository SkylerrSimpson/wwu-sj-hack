{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data.json",
  "type": "object",
  "required": ["sources", "records"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "$comment": "id of an entry in sources; check.py verifies it resolves"
          },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
