[Unit]
Description=Lummi vessel streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lummi
Group=lummi
WorkingDirectory=/opt/lummi-streamer/apps/streamer
EnvironmentFile=/etc/lummi-streamer.env
ExecStart=/opt/lummi-streamer/apps/streamer/.venv/bin/python -m streamer
Restart=always
RestartSec=5
StateDirectory=lummi-streamer
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
